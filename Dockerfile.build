# ---- Base: Docker-in-Docker (Alpine) ----
# Use a recent Docker DinD image so we get dockerd + CLI preinstalled
FROM docker:27-dind

# ---- Install OpenJDK 21 and tools ----
RUN apk add --no-cache \
      openjdk21-jdk \
      curl \
      bash \
      tar \
      ca-certificates \
      git \
      jq

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ---- Install Maven 4.x ----
# Pick the version you need; 4.0.0 shown as example.
ARG MAVEN_VERSION=4.0.0-rc-4
ARG MAVEN_BASE_URL=https://archive.apache.org/dist/maven/maven-4/${MAVEN_VERSION}/binaries
ARG MAVEN_TGZ=apache-maven-${MAVEN_VERSION}-bin.tar.gz

RUN set -eux; \
    curl -fsSL "${MAVEN_BASE_URL}/${MAVEN_TGZ}" -o "/tmp/${MAVEN_TGZ}" && \
    mkdir -p /usr/share/maven && \
    tar -xzf "/tmp/${MAVEN_TGZ}" -C /usr/share/maven --strip-components=1 && \
    rm -f "/tmp/${MAVEN_TGZ}"

ENV MAVEN_HOME=/usr/share/maven
ENV M2_HOME=/usr/share/maven
ENV PATH="${MAVEN_HOME}/bin:${PATH}"

# ---- (Optional) speed up Docker builds inside DinD ----
# You can preconfigure a registry mirror here if you have one:
# RUN mkdir -p /etc/docker && printf '{ "registry-mirrors": ["https://your-mirror"] }\n' > /etc/docker/daemon.json

# Expose Docker daemon port (optional; DinD uses /var/run/docker.sock by default)
EXPOSE 2375 2376

# The docker:dind entrypoint already starts dockerd and handles TLS if configured.
# No CMD needed—keep the upstream entrypoint.
