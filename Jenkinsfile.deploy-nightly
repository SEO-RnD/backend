pipeline {
  agent {
    docker {
      image 'thanosmourtk/dind-java-mvn:java21-mvn4'
      args '''
        --privileged
        --cgroupns=host
        -v /sys/fs/cgroup:/sys/fs/cgroup:rw
        -e DOCKER_TLS_CERTDIR=
        -v dind-data:/var/lib/docker
        -v $WORKSPACE/.m2:/root/.m2
      '''
      reuseNode true
    }
  }

  triggers {
    // Nightly build at 02:00
    cron('H 2 * * *')
  }

  environment {
    DISCORD_WEBHOOK = credentials('discord_webhook') // Discord webhook
    DOCKER_PAT      = credentials('dockerhub_pat')   // Docker Hub PAT
    APP_NAME        = "guides-app-backend"
    USERNAME_NAME   = "thanosmourtk"

    // Portainer credentials
    PORTAINER_URL     = credentials('portainer_server')
    PORTAINER_USER    = credentials('portainer_user')
    PORTAINER_PASS    = credentials('portainer_pass')
    STACK_ID          = credentials('portainer_stack_id')
  }

  stages {
    stage('Nightly Build & Push') {
      steps {
        script {
          def dateTag = new Date().format("yyyyMMdd-HHmm")
          env.IMAGE = "${USERNAME_NAME}/${APP_NAME}:nightly-${dateTag}"

          sh """
            set -eux
            echo "${DOCKER_PAT}" | docker login -u "${USERNAME_NAME}" --password-stdin

            docker build --pull -f Dockerfile.prod -t ${IMAGE} .
            docker push ${IMAGE}

            docker tag ${IMAGE} ${USERNAME_NAME}/${APP_NAME}:nightly
            docker push ${USERNAME_NAME}/${APP_NAME}:nightly

            docker logout
          """
        }
      }
    }

    stage('Deploy to Portainer') {
      steps {
        script {
          sh """
          # Authenticate with Portainer
          TOKEN=$(curl -s -X POST -H "Content-Type: application/json" \\
            -d '{"Username": "${PORTAINER_USER}", "Password": "${PORTAINER_PASS}"}' \\
            ${PORTAINER_URL}/auth | jq -r .jwt)

          # Trigger redeploy of stack
          curl -s -X POST -H "Authorization: Bearer $TOKEN" \\
            -H "Content-Type: application/json" \\
            ${PORTAINER_URL}/stacks/${STACK_ID}/git/redeploy
          """
        }
      }
    }

    stage('Notify Discord') {
      steps {
        script {
          sh """
          curl -sS -H "Content-Type: application/json" -X POST \\
            -d '{
              "embeds": [{
                "title": "✅ Nightly Image Built",
                "color": 3066993,
                "fields": [
                  {"name": "App", "value": "${APP_NAME}", "inline": true},
                  {"name": "Image", "value": "${IMAGE}", "inline": false}
                ],
                "footer": {"text": "Jenkins Nightly Build"}
              }]
            }' \${DISCORD_WEBHOOK}
          """
        }
      }
    }
  }
}
